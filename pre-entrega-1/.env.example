# Provider used by AsyncLLMManager: openai | anthropic
LLM_PROVIDER=openai
# Optional: provider used when the primary fails after its retries (leave empty to disable)
LLM_FALLBACK_PROVIDER=anthropic

# API keys (only the ones for the providers you use are required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_MAX_RETRIES=3
